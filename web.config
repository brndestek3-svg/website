<?xml version="1.0" encoding="utf-8"?>
<!--
  BRN Yazılım - statik site / IIS (Plesk Windows) yapılandırması
  Gereksinim: IIS URL Rewrite 2.x modülü (Plesk Windows'ta kurulu gelir).
  Modül yoksa <rewrite> bloğunu silin; site yine çalışır, yalnızca eski
  adreslerden yönlendirme yapılmaz.
-->
<configuration>
  <system.webServer>

    <!-- Varsayılan belge: eski site default.aspx kullanıyordu -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <remove fileExtension=".webp" /><mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".svg" /><mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff2" /><mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <!-- Varlıklar ?v= ile sürümlendiği için uzun önbellek güvenli -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
        <!-- HSTS: yalnızca HTTPS sertifikası kurulduktan ve site sorunsuz
             çalıştığı doğrulandıktan sonra yorumdan çıkarın. -->
        <!-- <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" /> -->
      </customHeaders>
    </httpProtocol>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <rewrite>
      <!-- Eski ASP.NET adresleri -> yeni statik sayfalar -->
      <rewriteMaps>
        <rewriteMap name="EskiAdresler">
          <add key="/tr" value="/" />
          <add key="/tr/" value="/" />
          <add key="/error" value="/" />

          <add key="/tr/menu/hakkimizda/3" value="/hakkimizda.html" />
          <add key="/tr/referanslar" value="/hakkimizda.html" />
          <add key="/tr/iletisim" value="/iletisim.html" />
          <add key="/tr/blog" value="/blog.html" />

          <add key="/tr/kategoriler/hizmetlerimiz/5" value="/hizmetler.html" />
          <add key="/tr/menu/is-ve-surec-yonetim-danismanligi/6" value="/hizmetler.html#surec" />
          <add key="/tr/menu/is-ve-surec-danismanligi/6" value="/hizmetler.html#surec" />
          <add key="/tr/menu/fonksiyonel-danismanlik/7" value="/hizmetler.html#fonksiyonel" />
          <add key="/tr/menu/destek-hizmetleri/8" value="/hizmetler.html#destek" />

          <add key="/tr/menu/cozumlerimiz/9" value="/cozumler.html" />
          <add key="/tr/kategoriler/sap-finansal-cozumler/10" value="/cozumler.html#fi" />
          <add key="/tr/menu/sap-finansal-cozumler/10" value="/cozumler.html#fi" />
          <add key="/tr/menu/sap-fi/11" value="/cozumler.html#fi" />
          <add key="/tr/menu/sap-co/12" value="/cozumler.html#fi" />
          <add key="/tr/menu/ufrs-raporlama/13" value="/cozumler.html#fi" />

          <add key="/tr/kategoriler/nakit-yonetimi-ve-planlama/14" value="/cozumler.html#cash" />
          <add key="/tr/menu/nakit-yonetimi-ve-planlama/14" value="/cozumler.html#cash" />
          <add key="/tr/menu/sap-liquidity-planner/15" value="/cozumler.html#cash" />
          <add key="/tr/menu/treasury-entegrasyonlari/16" value="/cozumler.html#cash" />

          <add key="/tr/kategoriler/arac-ve-police-yonetimi/17" value="/cozumler.html#fleet" />
          <add key="/tr/menu/arac-ve-police-yonetimi/17" value="/cozumler.html#fleet" />
          <add key="/tr/menu/sap-claims-management/18" value="/cozumler.html#fleet" />
          <add key="/tr/menu/sap-fleet-management--vms/19" value="/cozumler.html#fleet" />

          <add key="/tr/kategoriler/surec-ve-veri-danismanligi/20" value="/cozumler.html#data" />
          <add key="/tr/menu/surec-ve-veri-danismanligi/20" value="/cozumler.html#data" />
          <add key="/tr/menu/sap-data-migration/21" value="/cozumler.html#data" />
          <add key="/tr/menu/lsmw--idoc-uyarlamalari/22" value="/cozumler.html#data" />

          <add key="/tr/kategoriler/fiori--kullanici-deneyimi/23" value="/cozumler.html#fiori" />
          <add key="/tr/menu/fiori--kullanici-deneyimi/23" value="/cozumler.html#fiori" />
          <add key="/tr/menu/finansal-surecler-icin-modern-fiori-ekranlari/24" value="/cozumler.html#fiori" />
        </rewriteMap>
      </rewriteMaps>

      <rules>
        <!-- 1. HTTPS'e yönlendir -->
        <rule name="HTTPS zorunlu" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://www.brnyazilim.com/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2. www olmayan adresi www'ye yönlendir -->
        <rule name="www kanonik" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^brnyazilim\.com$" />
          </conditions>
          <action type="Redirect" url="https://www.brnyazilim.com/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 3. Eski adres haritası (301) -->
        <rule name="Eski adresler" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{EskiAdresler:{REQUEST_URI}}" pattern="(.+)" />
          </conditions>
          <action type="Redirect" url="{C:1}" redirectType="Permanent" appendQueryString="false" />
        </rule>

        <!-- 4. Haritada olmayan diğer tüm /tr/... adresleri ana sayfaya -->
        <rule name="Kalan eski adresler" stopProcessing="true">
          <match url="^(tr|en)(/.*)?$" />
          <action type="Redirect" url="/" redirectType="Permanent" appendQueryString="false" />
        </rule>

        <!-- 5. .aspx istekleri (eski uygulama kalıntısı) -->
        <rule name="Eski aspx" stopProcessing="true">
          <match url="\.aspx$" />
          <action type="Redirect" url="/" redirectType="Permanent" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>
</configuration>
